budgets:
  context_max_tokens: 12000
  min_context_savings_percent: 15
  step_max_tokens: 5000
entrypoints:
  clarify[1]: index
  complete[1]: handoff
  execute[1]: retrieve
  handoff[1]: handoff
  prepare[1]: preflight
  route[1]: index
  validate[1]: validate
schema: ai-sdlc-skill-steps/v2
skill: ai-sdlc-context-cache
steps[5]:
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: prepare
      roles[1]: software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[0]:
    gates[4]: authority,inputs,path-containment,authorization
    id: preflight
    load: required
    max_attempts: 1
    max_tokens: 520
    on_failure: block
    operation: inspect-cache-boundary
    outputs[2]: cache-boundary,blockers
    path: steps/01-prepare.md
    reason: establish safe local cache authority and bounded operation inputs
    side_effect: none
    type: analysis
  - capabilities[2]: filesystem.read,filesystem.write
    commit_boundary: after-step
    condition:
      actions[0]:
      phases[2]: clarify,route
      roles[1]: software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: preflight
    gates[4]: authorization,path-containment,secret-exclusion,atomic-write
    id: index
    load: required
    max_attempts: 1
    max_tokens: 470
    on_failure: block
    operation: build-or-refresh-index
    outputs[2]: cache-receipt,cache-fingerprint
    path: steps/02-index.md
    reason: create an explicit fresh deterministic retrieval projection
    side_effect: workspace-write
    type: action
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: execute
      roles[1]: software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: index
    gates[4]: freshness,context-sufficiency,graph-bounds,authority
    id: retrieve
    load: on-demand
    max_attempts: 1
    max_tokens: 520
    on_failure: handoff
    operation: query-or-pack-context
    outputs[2]: retrieved-evidence,context-pack
    path: steps/03-retrieve.md
    reason: retrieve the minimum fresh explained evidence within hard budgets
    side_effect: none
    type: context
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: validate
      roles[1]: software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: retrieve
    gates[5]: freshness,fingerprint,source-identity,context-economics,output-contract
    id: validate
    load: before-completion
    max_attempts: 1
    max_tokens: 480
    on_failure: block
    operation: verify-freshness-and-economics
    outputs[2]: validation-result,residual-risk
    path: steps/04-validate.md
    reason: prove cache evidence is current bounded and contract-valid
    side_effect: none
    type: validation
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: handoff,complete
      roles[1]: software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: validate
    gates[3]: terminal-evidence,next-owner,recovery-path
    id: handoff
    load: before-completion
    max_attempts: 1
    max_tokens: 420
    on_failure: handoff
    operation: handoff-cache-evidence
    outputs[2]: handoff,next-action
    path: steps/05-handoff.md
    reason: preserve fresh evidence identity economics and direct-read recovery
    side_effect: none
    type: handoff
version: 4.1.0
