budgets:
  context_max_tokens: 12000
  min_context_savings_percent: 15
  step_max_tokens: 5000
entrypoints:
  clarify[1]: context
  complete[1]: handoff
  execute[1]: execute
  handoff[1]: handoff
  prepare[1]: prepare
  route[1]: context
  validate[1]: validate
schema: ai-sdlc-skill-steps/v2
skill: ai-sdlc-scheduler
steps[5]:
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: prepare
      roles[2]: product-manager,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[0]:
    gates[3]: authority,inputs,path-containment
    id: prepare
    load: required
    max_attempts: 1
    max_tokens: 1100
    on_failure: block
    operation: inspect-scheduler-inputs
    outputs[2]: routing-evidence,blockers
    path: steps/01-prepare.md
    reason: establish deterministic scheduling authority and inputs
    side_effect: none
    type: analysis
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: clarify,route
      roles[2]: product-manager,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: prepare
    gates[2]: context-sufficiency,critical-anchor-recall
    id: context
    load: required
    max_attempts: 1
    max_tokens: 360
    on_failure: block
    operation: validate-step-context
    outputs[2]: context-pack,context-fingerprint
    path: steps/02-context.md
    reason: reject stale context before a lease or effect
    side_effect: none
    type: context
  - capabilities[2]: filesystem.read,filesystem.write
    commit_boundary: after-step
    condition:
      actions[0]:
      phases[1]: execute
      roles[2]: product-manager,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: context
    gates[4]: dependencies,context-sufficiency,revision,authorization
    id: execute
    load: on-demand
    max_attempts: 3
    max_tokens: 800
    on_failure: retry
    operation: schedule-one-transition
    outputs[2]: scheduler-state,scheduler-event
    path: steps/03-execute.md
    reason: atomically claim recover or commit one bounded task transition
    side_effect: workspace-write
    type: action
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: validate
      roles[2]: product-manager,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: execute
    gates[3]: event-chain,state-fingerprint,lease-safety
    id: validate
    load: before-completion
    max_attempts: 1
    max_tokens: 560
    on_failure: block
    operation: replay-and-validate
    outputs[2]: validation-result,residual-risk
    path: steps/04-validate.md
    reason: prove deterministic projection and lease safety
    side_effect: none
    type: validation
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: handoff,complete
      roles[2]: product-manager,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: validate
    gates[2]: terminal-evidence,next-owner
    id: handoff
    load: before-completion
    max_attempts: 1
    max_tokens: 520
    on_failure: handoff
    operation: handoff-scheduler-state
    outputs[2]: handoff,next-action
    path: steps/05-handoff.md
    reason: preserve durable continuation context
    side_effect: none
    type: handoff
version: 4.1.0
