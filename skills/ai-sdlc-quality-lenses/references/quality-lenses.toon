default_quick_lenses[2]: edge-case-hunt,assumption-challenge
lenses[8]:
  - applies_to[6]: requirements,design,plan,tasks,release,general
    id: pre-mortem
    name: Pre-mortem
    prompt: Assume the outcome failed; identify evidence-backed causes and earlier controls.
  - applies_to[5]: requirements,design,tests,change,general
    id: adversarial-review
    name: Adversarial review
    prompt: "Challenge claims, boundaries, and happy-path assumptions using contrary evidence."
  - applies_to[6]: requirements,design,tests,change,ux,general
    id: edge-case-hunt
    name: Edge-case hunt
    prompt: "Find boundary values, empty states, races, retries, partial failures, and uncommon actors."
  - applies_to[5]: requirements,plan,ux,release,general
    id: stakeholder-conflict
    name: Stakeholder conflict
    prompt: "Expose incompatible goals, incentives, permissions, and ownership expectations."
  - applies_to[5]: design,plan,change,release,general
    id: reversibility-check
    name: Reversibility check
    prompt: "Test rollback, migration, data recovery, compatibility, and decision reversibility."
  - applies_to[6]: requirements,design,tests,change,ux,general
    id: abuse-case-review
    name: Abuse-case review
    prompt: "Identify misuse, privilege, trust-boundary, validation, and data-exposure paths."
  - applies_to[6]: design,plan,tests,change,release,general
    id: operational-failure-review
    name: Operational failure review
    prompt: "Challenge observability, degradation, dependency failure, recovery, and operator response."
  - applies_to[10]: requirements,design,plan,tasks,tests,change,ux,research,release,general
    id: assumption-challenge
    name: Assumption challenge
    prompt: "Locate unsupported, stale, hidden, or mutually inconsistent assumptions."
schema: ai-sdlc-quality-lens-registry/v1
version: 1.0.0
