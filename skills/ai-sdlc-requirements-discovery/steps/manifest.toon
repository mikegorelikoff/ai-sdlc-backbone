budgets:
  context_max_tokens: 12000
  min_context_savings_percent: 15
  step_max_tokens: 5000
entrypoints:
  clarify[1]: context
  complete[1]: handoff
  execute[1]: execute
  handoff[1]: handoff
  prepare[1]: preflight
  route[1]: context
  validate[1]: validate
schema: ai-sdlc-skill-steps/v2
skill: ai-sdlc-requirements-discovery
steps[5]:
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: prepare
      roles[4]: business-analyst,product-manager,software-engineer,qa-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[0]:
    gates[3]: authority,inputs,path-containment
    id: preflight
    load: required
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: bound-discovery
    outputs[3]: raw-request,source-boundary,discovery-scope
    path: steps/01-prepare.md
    reason: bound the feature or task and identify available raw inputs
    side_effect: none
    type: analysis
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: clarify,route
      roles[4]: business-analyst,product-manager,software-engineer,qa-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: preflight
    gates[2]: context-sufficiency,critical-anchor-recall
    id: context
    load: required
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: collect-requirements-evidence
    outputs[3]: source-inventory,precedent-evidence,unknowns
    path: steps/02-context.md
    reason: select source evidence and test whether precedents transfer
    side_effect: none
    type: context
  - capabilities[2]: filesystem.read,filesystem.write
    commit_boundary: after-step
    condition:
      actions[0]:
      phases[1]: execute
      roles[4]: business-analyst,product-manager,software-engineer,qa-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: context
    gates[3]: dependencies,context-sufficiency,authorization
    id: execute
    load: on-demand
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: analyze-business-options
    outputs[3]: requirements-analysis,business-options,stakeholder-questions
    path: steps/02-execute.md
    reason: compare business responses and prepare decision-linked stakeholder questions
    side_effect: workspace-write
    type: action
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: validate
      roles[4]: business-analyst,product-manager,software-engineer,qa-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: execute
    gates[3]: output-evidence,acceptance,regression-risk
    id: validate
    load: before-completion
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: validate-discovery
    outputs[2]: validation-result,decision-gaps
    path: steps/03-validate-and-handoff.md
    reason: "check traceability, option distinctions, and unresolved product choices"
    side_effect: none
    type: validation
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: handoff,complete
      roles[4]: business-analyst,product-manager,software-engineer,qa-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: validate
    gates[2]: terminal-evidence,next-owner
    id: handoff
    load: before-completion
    max_attempts: 1
    max_tokens: 3000
    on_failure: handoff
    operation: handoff-result
    outputs[2]: handoff,next-action
    path: steps/04-handoff.md
    reason: return the elicitation packet and next accountable owner
    side_effect: none
    type: handoff
version: 4.1.0
