"$id": ai-sdlc-upgrade-inventory/v1
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  files:
    items:
      additionalProperties: false
      properties:
        path:
          type: string
        schema:
          type: string
        sha256:
          pattern: "^[a-f0-9]{64}$"
          type: string
      required[3]: path,sha256,schema
      type: object
    type: array
  harness_api:
    type: object
  schema:
    const: ai-sdlc-upgrade-inventory/v1
  version:
    type: string
required[4]: schema,version,harness_api,files
type: object
