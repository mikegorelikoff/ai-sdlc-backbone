"$defs":
  hash:
    pattern: "^[a-f0-9]{64}$"
    type: string
"$id": ai-sdlc-eval-receipt/v1
"$schema": ai-sdlc-toon-contract/v1
properties:
  failed:
    minimum: 0
    type: integer
  harness_version:
    const: 4.0.0
  items:
    items:
      type: object
    type: array
  mode:
    enum[2]: deterministic,live-protocol
  passed:
    minimum: 0
    type: integer
  portable_receipt_template:
    type: object
  protocol:
    type: object
  receipt_fingerprint:
    "$ref": #/$defs/hash
  result:
    enum[2]: passed,failed
  schema:
    const: ai-sdlc-eval-receipt/v1
required[7]: schema,mode,harness_version,passed,failed,result,receipt_fingerprint
title: AI SDLC Deterministic Or Live-Protocol Evaluation Receipt
type: object
