"$defs":
  hash:
    pattern: "^[a-f0-9]{64}$"
    type: string
"$id": ai-sdlc-provider-execution/v1
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  agent_attested:
    type: boolean
  effect_receipts:
    items:
      minLength: 1
      type: string
    type: array
    uniqueItems: true
  executed_at:
    format: date-time
    type: string
  execution_id:
    minLength: 1
    type: string
  execution_mode:
    const: provider
  host:
    minLength: 1
    type: string
  model:
    minLength: 1
    type: string
  protocol_fingerprint:
    "$ref": #/$defs/hash
  provider:
    minLength: 1
    type: string
  recovery_evidence:
    items:
      minLength: 1
      type: string
    minItems: 1
    type: array
    uniqueItems: true
  scenario_results:
    items:
      additionalProperties: false
      properties:
        evidence:
          items:
            minLength: 1
            type: string
          minItems: 1
          type: array
          uniqueItems: true
        id:
          minLength: 1
          type: string
        score:
          maximum: 100
          minimum: 0
          type: integer
        status:
          enum[2]: passed,failed
      required[4]: id,status,score,evidence
      type: object
    minItems: 1
    type: array
  scenario_version:
    minLength: 1
    type: string
  schema:
    const: ai-sdlc-provider-execution/v1
required[13]: schema,execution_mode,protocol_fingerprint,provider,host,model,execution_id,executed_at,scenario_version,agent_attested,scenario_results,effect_receipts,recovery_evidence
title: AI SDLC Provider Execution Observation
type: object
