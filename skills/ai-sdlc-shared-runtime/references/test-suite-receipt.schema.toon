"$defs":
  hash:
    pattern: "^[a-f0-9]{64}$"
    type: string
  item:
    additionalProperties: false
    properties:
      diagnostic:
        type: string
      exit_code:
        type: integer
      path:
        pattern: "^skills/ai-sdlc-[a-z0-9]+(?:-[a-z0-9]+)*/tests/test_[a-z0-9_]+\\.py$"
        type: string
      status:
        enum[2]: passed,failed
    required[3]: path,status,exit_code
    type: object
"$id": ai-sdlc-test-suite-receipt/v1
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  failed:
    minimum: 0
    type: integer
  fingerprint:
    "$ref": #/$defs/hash
  items:
    items:
      "$ref": #/$defs/item
    minItems: 1
    type: array
  passed:
    minimum: 0
    type: integer
  result:
    enum[2]: passed,failed
  schema:
    const: ai-sdlc-test-suite-receipt/v1
  test_files:
    minimum: 1
    type: integer
required[7]: schema,test_files,passed,failed,result,items,fingerprint
title: AI SDLC Complete Skill Test-Suite Receipt
type: object
