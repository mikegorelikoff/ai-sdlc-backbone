{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-sdlc-skill-steps/v1",
  "type": "object",
  "required": ["schema", "skill", "selectors"],
  "properties": {
    "schema": {"const": "ai-sdlc-skill-steps/v1"},
    "skill": {
      "type": "string",
      "pattern": "^ai-sdlc-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/selector"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "selector": {
      "type": "object",
      "required": [
        "id",
        "path",
        "phases",
        "roles",
        "actions",
        "load",
        "max_tokens",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "path": {
          "type": "string",
          "pattern": "^steps/[a-z0-9][a-z0-9-]*\\.md$"
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "prepare",
              "clarify",
              "route",
              "execute",
              "handoff",
              "validate",
              "complete"
            ]
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "business-analyst",
              "product-manager",
              "software-architect",
              "software-engineer",
              "qa-engineer"
            ]
          },
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "load": {
          "enum": ["required", "on-demand", "before-completion"]
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 64,
          "maximum": 5000
        },
        "reason": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        }
      },
      "additionalProperties": false
    }
  }
}
