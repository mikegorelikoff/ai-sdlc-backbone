"$defs":
  hash:
    pattern: "^[a-f0-9]{64}$"
    type: string
"$id": ai-sdlc-live-eval-receipt/v1
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  agent_attested:
    type: boolean
  effect_receipts:
    items:
      type: string
    type: array
  executed_at:
    type: string
  execution_id:
    type: string
  execution_mode:
    enum[2]: provider,offline-or-unattested
  fingerprint:
    "$ref": #/$defs/hash
  host:
    type: string
  model:
    type: string
  protocol_fingerprint:
    "$ref": #/$defs/hash
  provider:
    type: string
  recovery_evidence:
    items:
      type: string
    type: array
  scenario_results:
    items:
      type: object
    type: array
  scenario_version:
    type: string
  schema:
    const: ai-sdlc-live-eval-receipt/v1
  scores:
    type: object
  status:
    enum[3]: passed,failed,pending
  thresholds:
    type: object
required[17]: schema,protocol_fingerprint,execution_mode,provider,host,model,execution_id,executed_at,scenario_version,agent_attested,status,scenario_results,scores,thresholds,effect_receipts,recovery_evidence,fingerprint
title: AI SDLC Provider Live Evaluation Receipt
type: object
