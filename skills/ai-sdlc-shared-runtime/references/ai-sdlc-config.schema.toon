"$defs":
  context_selector:
    additionalProperties: false
    properties:
      actions:
        items:
          enum[9]: branching,commit,implementation,new_refinement,qa_planning,review,security_review,story_decomposition,validation
        type: array
        uniqueItems: true
      id:
        pattern: "^[a-z][a-z0-9-]{0,63}$"
        type: string
      include:
        items:
          pattern: "^(references|steps)/[^.][^/]*(/[^.][^/]*)*$"
          type: string
        type: array
        uniqueItems: true
      max_tokens:
        maximum: 4000
        minimum: 16
        type: integer
      priority:
        maximum: 100
        minimum: 0
        type: integer
      reason:
        maxLength: 240
        minLength: 8
        type: string
      roles:
        items:
          enum[5]: business-analyst,product-manager,software-architect,software-engineer,qa-engineer
        type: array
        uniqueItems: true
    required[7]: id,roles,actions,include,priority,max_tokens,reason
    type: object
  flow:
    additionalProperties: false
    properties:
      context_selectors:
        items:
          "$ref": #/$defs/context_selector
        type: array
      menu_mode:
        enum[2]: ambiguous,always
      role_aliases:
        additionalProperties:
          enum[5]: business-analyst,product-manager,software-architect,software-engineer,qa-engineer
        propertyNames:
          pattern: "^[a-z][a-z0-9-]{0,39}$"
        type: object
    type: object
  interaction:
    additionalProperties: false
    properties:
      enabled:
        type: boolean
      language:
        pattern: "^(auto|[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*)$"
        type: string
      preferred_name:
        maxLength: 80
        pattern: "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
        type: string
      response_style:
        enum[3]: concise,balanced,detailed
      status_updates:
        enum[3]: minimal,milestones,frequent
      technical_depth:
        enum[4]: adaptive,foundational,practitioner,expert
    type: object
"$id": "https://raw.githubusercontent.com/mikegorelikoff/ai-sdlc-harness/main/skills/ai-sdlc-shared-runtime/references/ai-sdlc-config.schema.toon"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  protected:
    items:
      minLength: 1
      type: string
    type: array
    uniqueItems: true
  schema:
    const: ai-sdlc-config/v1
  values:
    additionalProperties: true
    properties:
      flow:
        "$ref": #/$defs/flow
      interaction:
        "$ref": #/$defs/interaction
    type: object
required[2]: schema,values
title: AI SDLC presentation configuration
type: object
