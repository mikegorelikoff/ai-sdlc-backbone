"$defs":
  condition:
    additionalProperties: false
    properties:
      actions:
        items:
          minLength: 1
          type: string
        type: array
        uniqueItems: true
      phases:
        "$ref": #/$defs/phases
      roles:
        "$ref": #/$defs/roles
    required[3]: phases,roles,actions
    type: object
  context:
    additionalProperties: false
    properties:
      budget_tokens:
        maximum: 24000
        minimum: 64
        type: integer
      critical_anchors:
        items:
          minLength: 1
          type: string
        minItems: 1
        type: array
        uniqueItems: true
      fallback:
        const: direct_read
      mandatory:
        const[1]: step_document
      min_savings_percent:
        maximum: 100
        minimum: 0
        type: number
      required:
        const: true
      selectors:
        contains:
          const: step
        items:
          enum[4]: step,repository-instructions,feature-traces,changed-path-topology
        minItems: 1
        type: array
        uniqueItems: true
    required[7]: required,budget_tokens,mandatory,selectors,critical_anchors,min_savings_percent,fallback
    type: object
  phases:
    items:
      enum[7]: prepare,clarify,route,execute,handoff,validate,complete
    minItems: 1
    type: array
    uniqueItems: true
  roles:
    items:
      enum[5]: business-analyst,product-manager,software-architect,software-engineer,qa-engineer
    type: array
    uniqueItems: true
  step:
    additionalProperties: false
    properties:
      capabilities:
        items:
          pattern: "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
          type: string
        minItems: 1
        type: array
        uniqueItems: true
      commit_boundary:
        enum[2]: none,after-step
      condition:
        "$ref": #/$defs/condition
      context:
        "$ref": #/$defs/context
      depends_on:
        items:
          "$ref": #/$defs/stepId
        type: array
        uniqueItems: true
      gates:
        items:
          minLength: 1
          type: string
        minItems: 1
        type: array
        uniqueItems: true
      id:
        "$ref": #/$defs/stepId
      load:
        enum[3]: required,on-demand,before-completion
      max_attempts:
        maximum: 5
        minimum: 1
        type: integer
      max_tokens:
        maximum: 5000
        minimum: 64
        type: integer
      on_failure:
        enum[3]: block,retry,handoff
      operation:
        pattern: "^[a-z][a-z0-9-]{1,63}$"
        type: string
      outputs:
        items:
          minLength: 1
          type: string
        minItems: 1
        type: array
        uniqueItems: true
      path:
        pattern: "^steps/[a-z0-9][a-z0-9-]*\\.md$"
        type: string
      reason:
        maxLength: 240
        minLength: 8
        type: string
      side_effect:
        enum[4]: none,workspace-write,external-write,destructive
      type:
        enum[5]: analysis,context,action,validation,handoff
    required[17]: id,path,type,depends_on,condition,load,max_tokens,reason,operation,capabilities,side_effect,context,gates,outputs,max_attempts,commit_boundary,on_failure
    type: object
  stepId:
    pattern: "^[a-z][a-z0-9-]{0,63}$"
    type: string
  stepIds:
    items:
      "$ref": #/$defs/stepId
    minItems: 1
    type: array
    uniqueItems: true
"$id": ai-sdlc-skill-steps/v2
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  budgets:
    additionalProperties: false
    properties:
      context_max_tokens:
        maximum: 24000
        minimum: 64
        type: integer
      min_context_savings_percent:
        maximum: 100
        minimum: 0
        type: number
      step_max_tokens:
        maximum: 5000
        minimum: 64
        type: integer
    required[3]: step_max_tokens,context_max_tokens,min_context_savings_percent
    type: object
  entrypoints:
    additionalProperties: false
    properties:
      clarify:
        "$ref": #/$defs/stepIds
      complete:
        "$ref": #/$defs/stepIds
      execute:
        "$ref": #/$defs/stepIds
      handoff:
        "$ref": #/$defs/stepIds
      prepare:
        "$ref": #/$defs/stepIds
      route:
        "$ref": #/$defs/stepIds
      validate:
        "$ref": #/$defs/stepIds
    required[7]: prepare,clarify,route,execute,handoff,validate,complete
    type: object
  schema:
    const: ai-sdlc-skill-steps/v2
  skill:
    pattern: "^ai-sdlc-[a-z0-9]+(?:-[a-z0-9]+)*$"
    type: string
  steps:
    items:
      "$ref": #/$defs/step
    minItems: 5
    type: array
  version:
    const: 4.1.0
required[6]: schema,skill,version,entrypoints,budgets,steps
type: object
