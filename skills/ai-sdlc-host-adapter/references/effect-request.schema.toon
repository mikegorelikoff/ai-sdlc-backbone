"$defs":
  hash:
    pattern: "^[a-f0-9]{64}$"
    type: string
"$id": ai-sdlc-effect-request/v1
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  adapter_id:
    type: string
  approval_ref:
    type: string
  arguments:
    type: object
  capabilities:
    items:
      type: string
    type: array
  context_fingerprint:
    "$ref": #/$defs/hash
  driver:
    enum[2]: workspace.write-text,external.toon-post
  idempotency_key:
    "$ref": #/$defs/hash
  negotiation_fingerprint:
    "$ref": #/$defs/hash
  operation:
    type: string
  schema:
    const: ai-sdlc-effect-request/v1
  side_effect:
    enum[4]: none,workspace-write,external-write,destructive
  step_fingerprint:
    "$ref": #/$defs/hash
required[12]: schema,driver,adapter_id,negotiation_fingerprint,step_fingerprint,context_fingerprint,operation,side_effect,capabilities,approval_ref,arguments,idempotency_key
title: AI SDLC Effect Request
type: object
