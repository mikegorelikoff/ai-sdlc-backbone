"$id": ai-sdlc-local-metrics/v1
"$schema": ai-sdlc-toon-contract/v1
properties:
  budgets:
    type: object
  fingerprint:
    pattern: "^[a-f0-9]{64}$"
    type: string
  inputs_fingerprint:
    type: string
  quality:
    type: object
  runs:
    type: object
  schema:
    const: ai-sdlc-local-metrics/v1
  status:
    enum[2]: available,insufficient-data
  tasks:
    type: object
required[8]: schema,status,runs,tasks,budgets,quality,inputs_fingerprint,fingerprint
type: object
