"$id": "https://github.com/mikegorelikoff/ai-sdlc-harness/schemas/ai-sdlc-change-set-v1"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  applied_at:
    format: date-time
    type: string
  approval:
    type: object
  archive_path:
    type: string
  archived_at:
    format: date-time
    type: string
  artifacts:
    type: object
  authority:
    type: object
  canonical_targets:
    items:
      minLength: 1
      type: string
    minItems: 1
    type: array
    uniqueItems: true
  change_id:
    pattern: "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    type: string
  contract_fingerprint:
    pattern: "^[a-f0-9]{64}$"
    type: string
  created_at:
    format: date
    type: string
  flow_mode:
    enum[3]: default,quick,full
  owner:
    minLength: 1
    type: string
  preview_fingerprint:
    pattern: "^[a-f0-9]{64}$"
    type: string
  schema:
    const: ai-sdlc-change-set/v1
  status:
    enum[3]: draft,applied,archived
  summary:
    minLength: 1
    type: string
  title:
    minLength: 1
    type: string
  updated_at:
    format: date
    type: string
required[13]: schema,change_id,title,summary,status,owner,flow_mode,created_at,updated_at,canonical_targets,artifacts,authority,contract_fingerprint
title: AI SDLC Change Set
type: object
