"$id": "https://github.com/mikegorelikoff/ai-sdlc-harness/schemas/ai-sdlc-spec-delta-v1"
"$schema": ai-sdlc-toon-contract/v1
properties:
  change_id:
    type: string
  contract_fingerprint:
    pattern: "^[a-f0-9]{64}$"
    type: string
  operations:
    items:
      properties:
        name:
          type: string
        operation:
          enum[4]: ADDED,MODIFIED,REMOVED,RENAMED
        requirement_id:
          type: string
        source:
          type: string
        source_hash:
          pattern: "^[a-f0-9]{64}$"
          type: string
        source_line:
          minimum: 1
          type: integer
        target:
          type: string
      required[7]: operation,target,requirement_id,name,source,source_line,source_hash
      type: object
    minItems: 1
    type: array
  schema:
    const: ai-sdlc-spec-delta/v1
  sources:
    minItems: 1
    type: array
  status:
    const: validated
required[6]: schema,change_id,status,operations,sources,contract_fingerprint
title: AI SDLC Specification Delta Set
type: object
