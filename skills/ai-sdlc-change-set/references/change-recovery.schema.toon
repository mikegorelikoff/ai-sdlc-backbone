"$id": "https://github.com/mikegorelikoff/ai-sdlc-harness/schemas/ai-sdlc-change-recovery-v1"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  applied:
    items:
      type: string
    type: array
    uniqueItems: true
  change_id:
    type: string
  created_at:
    format: date-time
    type: string
  preview_fingerprint:
    pattern: "^[a-f0-9]{64}$"
    type: string
  rollback_errors:
    items:
      type: string
    type: array
  schema:
    const: ai-sdlc-change-recovery/v1
  status:
    enum[4]: in_progress,complete,rolled_back,rollback_failed
  targets:
    items:
      additionalProperties: false
      properties:
        after_sha256:
          pattern: "^[a-f0-9]{64}$"
          type: string
        backup:
          type: string
        before_sha256:
          pattern: "^[a-f0-9]{64}$"
          type: string
        existed:
          type: boolean
        staging:
          type: string
        target:
          type: string
      required[6]: target,existed,backup,staging,before_sha256,after_sha256
      type: object
    type: array
  updated_at:
    format: date-time
    type: string
required[9]: schema,change_id,status,preview_fingerprint,created_at,updated_at,targets,applied,rollback_errors
title: AI SDLC Change Recovery Manifest
type: object
