budgets:
  context_max_tokens: 12000
  min_context_savings_percent: 15
  step_max_tokens: 5000
entrypoints:
  clarify[1]: context
  complete[1]: handoff
  execute[1]: execute
  handoff[1]: handoff
  prepare[1]: preflight
  route[1]: context
  validate[1]: validate
schema: ai-sdlc-skill-steps/v2
skill: ai-sdlc-evidence-council
steps[5]:
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: prepare
      roles[5]: business-analyst,product-manager,qa-engineer,software-architect,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[0]:
    gates[3]: authority,inputs,path-containment
    id: preflight
    load: required
    max_attempts: 1
    max_tokens: 1249
    on_failure: block
    operation: inspect-and-route
    outputs[2]: routing-evidence,blockers
    path: steps/01-prepare.md
    reason: "establish inputs, authority, lifecycle state, and safe artifact routing"
    side_effect: none
    type: analysis
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: clarify,route
      roles[5]: business-analyst,product-manager,qa-engineer,software-architect,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: preflight
    gates[2]: context-sufficiency,critical-anchor-recall
    id: context
    load: required
    max_attempts: 1
    max_tokens: 374
    on_failure: block
    operation: compile-context
    outputs[2]: context-pack,context-fingerprint
    path: steps/02-context.md
    reason: compile the minimum sufficient context before the owning action
    side_effect: none
    type: context
  - capabilities[2]: filesystem.read,filesystem.write
    commit_boundary: after-step
    condition:
      actions[0]:
      phases[1]: execute
      roles[5]: business-analyst,product-manager,qa-engineer,software-architect,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: context
    gates[3]: dependencies,context-sufficiency,authorization
    id: execute
    load: on-demand
    max_attempts: 1
    max_tokens: 684
    on_failure: block
    operation: execute-procedure
    outputs[2]: procedure-result,execution-evidence
    path: steps/02-execute.md
    reason: perform only the selected owning-skill procedure
    side_effect: workspace-write
    type: action
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: validate
      roles[5]: business-analyst,product-manager,qa-engineer,software-architect,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: execute
    gates[3]: output-evidence,acceptance,regression-risk
    id: validate
    load: before-completion
    max_attempts: 1
    max_tokens: 573
    on_failure: block
    operation: validate-evidence
    outputs[2]: validation-result,residual-risk
    path: steps/03-validate-and-handoff.md
    reason: "validate outputs, evidence, acceptance, and residual risk"
    side_effect: none
    type: validation
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: handoff,complete
      roles[5]: business-analyst,product-manager,qa-engineer,software-architect,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: validate
    gates[2]: terminal-evidence,next-owner
    id: handoff
    load: before-completion
    max_attempts: 1
    max_tokens: 361
    on_failure: handoff
    operation: handoff-result
    outputs[2]: handoff,next-action
    path: steps/04-handoff.md
    reason: return a journal-backed owner and next-action handoff
    side_effect: none
    type: handoff
