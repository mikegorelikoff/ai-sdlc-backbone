"$id": "https://github.com/mikegorelikoff/ai-sdlc-harness/schemas/ai-sdlc-delivery-node-v1"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  anchors:
    items:
      additionalProperties: false
      properties:
        line:
          minimum: 0
          type: integer
        path:
          type: string
      required[2]: path,line
      type: object
    minItems: 1
    type: array
  fingerprint:
    pattern: "^[a-f0-9]{64}$"
    type: string
  id:
    minLength: 1
    type: string
  key:
    minLength: 1
    type: string
  kind:
    enum[10]: goal,requirement,decision,component,task,test,evidence,commit,release,artifact
  schema:
    const: ai-sdlc-delivery-node/v1
  status:
    enum[3]: declared,referenced,recorded
  title:
    type: string
required[8]: schema,id,kind,key,title,status,anchors,fingerprint
title: AI SDLC Delivery Graph Node
type: object
