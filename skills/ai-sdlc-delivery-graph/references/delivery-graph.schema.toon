"$id": "https://github.com/mikegorelikoff/ai-sdlc-harness/schemas/ai-sdlc-delivery-graph-v1"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  coverage:
    type: object
  edges:
    items:
      "$ref": delivery-edge.schema.toon
    type: array
  fingerprint:
    pattern: "^[a-f0-9]{64}$"
    type: string
  gaps:
    items:
      type: object
    type: array
  nodes:
    items:
      "$ref": delivery-node.schema.toon
    type: array
  orphans:
    items:
      type: string
    type: array
  schema:
    const: ai-sdlc-delivery-graph/v1
  source_fingerprint:
    pattern: "^[a-f0-9]{64}$"
    type: string
required[8]: schema,source_fingerprint,nodes,edges,coverage,gaps,orphans,fingerprint
title: AI SDLC Delivery Graph
type: object
