"$defs":
  fileIdentity:
    additionalProperties: false
    properties:
      path:
        minLength: 1
        type: string
      sha256:
        pattern: "^[a-f0-9]{64}$"
        type: string
    required[2]: path,sha256
    type: object
"$id": "https://github.com/mikegorelikoff/ai-sdlc-harness/schemas/ai-sdlc-evidence-source-v1"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  artifact:
    "$ref": #/$defs/fileIdentity
  captured_at:
    format: date-time
    type: string
  dependencies:
    items:
      "$ref": #/$defs/fileIdentity
    type: array
  depends_on:
    items:
      type: string
    type: array
    uniqueItems: true
  expires_at:
    format: date-time
    type: string
  id:
    pattern: "^[a-z0-9][a-z0-9.-]*$"
    type: string
  kind:
    enum[6]: test,validation,approval,review,research,release
  producer:
    minLength: 1
    type: string
  schema:
    const: ai-sdlc-evidence-source/v1
  subjects:
    items:
      type: string
    minItems: 1
    type: array
    uniqueItems: true
required[9]: schema,id,kind,subjects,producer,captured_at,artifact,dependencies,depends_on
title: AI SDLC Evidence Source
type: object
