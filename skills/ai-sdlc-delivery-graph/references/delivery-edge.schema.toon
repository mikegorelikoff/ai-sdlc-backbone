"$id": "https://github.com/mikegorelikoff/ai-sdlc-harness/schemas/ai-sdlc-delivery-edge-v1"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  evidence:
    additionalProperties: false
    properties:
      line:
        minimum: 0
        type: integer
      path:
        type: string
    required[2]: path,line
    type: object
  fingerprint:
    pattern: "^[a-f0-9]{64}$"
    type: string
  id:
    pattern: "^edge:[a-f0-9]{16}$"
    type: string
  relation:
    enum[7]: declares,traces-to,verifies,implements,implemented-by,proves,releases
  schema:
    const: ai-sdlc-delivery-edge/v1
  source:
    type: string
  target:
    type: string
required[7]: schema,id,source,target,relation,evidence,fingerprint
title: AI SDLC Delivery Graph Edge
type: object
