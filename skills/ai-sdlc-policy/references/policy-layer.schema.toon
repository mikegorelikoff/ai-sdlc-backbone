"$id": "https://github.com/mikegorelikoff/ai-sdlc-harness/schemas/ai-sdlc-policy-layer-v1"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  id:
    minLength: 1
    type: string
  rules:
    items:
      type: object
    type: array
  schema:
    const: ai-sdlc-policy-layer/v1
  scope:
    enum[4]: base,organization,project,user
  version:
    pattern: "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    type: string
required[5]: schema,id,version,scope,rules
title: AI SDLC Policy Layer
type: object
