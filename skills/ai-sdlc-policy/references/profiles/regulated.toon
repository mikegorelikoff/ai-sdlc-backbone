id: regulated
rules[3]:
  - actions[1]: change.apply
    description: "Require auditable, current, privacy-reviewed, and security-reviewed canonical changes."
    effect: require
    id: org-regulated-change
    protected: true
    required_gates[4]: audit-evidence,fresh-evidence,privacy-review,security-review
    waivable: true
    when[0]:
  - actions[1]: release.publish
    description: Require regulated release evidence and signed provenance.
    effect: require
    id: org-regulated-release
    protected: true
    required_gates[5]: audit-evidence,fresh-evidence,privacy-review,security-review,signed-provenance
    waivable: false
    when[0]:
  - actions[1]: data.production.read
    description: Deny production data use as AI task context.
    effect: deny
    id: org-regulated-production-data
    protected: true
    required_gates[0]:
    waivable: false
    when[1]{field,operator,value}:
      purpose,eq,ai-context
schema: ai-sdlc-policy-layer/v1
scope: organization
version: 1.0.0
