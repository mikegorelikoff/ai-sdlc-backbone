"$id": "https://github.com/mikegorelikoff/ai-sdlc-harness/schemas/ai-sdlc-policy-waiver-v1"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  actions:
    items:
      type: string
    minItems: 1
    type: array
    uniqueItems: true
  approved_by:
    minLength: 1
    type: string
  constraints:
    type: object
  decision_ref:
    minLength: 1
    type: string
  expires_at:
    format: date-time
    type: string
  id:
    minLength: 1
    type: string
  issued_at:
    format: date-time
    type: string
  owner:
    minLength: 1
    type: string
  reason:
    minLength: 1
    type: string
  rule_id:
    minLength: 1
    type: string
  schema:
    const: ai-sdlc-policy-waiver/v1
  subject:
    minLength: 1
    type: string
required[12]: schema,id,rule_id,actions,subject,constraints,owner,approved_by,decision_ref,reason,issued_at,expires_at
title: AI SDLC Policy Waiver
type: object
