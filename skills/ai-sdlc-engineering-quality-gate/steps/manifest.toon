budgets:
  context_max_tokens: 12000
  min_context_savings_percent: 15
  step_max_tokens: 5000
entrypoints:
  clarify[1]: context
  complete[1]: handoff
  execute[1]: execute
  handoff[1]: handoff
  prepare[1]: preflight
  route[1]: context
  validate[1]: validate
schema: ai-sdlc-skill-steps/v2
skill: ai-sdlc-engineering-quality-gate
steps[5]:
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: prepare
      roles[3]: qa-engineer,software-architect,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[0]:
    gates[4]: authority,inputs,review-target,path-containment
    id: preflight
    load: required
    max_attempts: 1
    max_tokens: 1800
    on_failure: block
    operation: inspect-and-route
    outputs[3]: review-boundary,routing-evidence,blockers
    path: steps/01-prepare.md
    reason: "establish the request, diff boundary, authority, and safe TOON routes"
    side_effect: none
    type: analysis
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: clarify,route
      roles[3]: qa-engineer,software-architect,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: preflight
    gates[3]: context-sufficiency,critical-anchor-recall,deterministic-ranking
    id: context
    load: required
    max_attempts: 1
    max_tokens: 1100
    on_failure: block
    operation: compile-context
    outputs[4]: context-plan,representative-candidates,applicable-patterns,context-fingerprint
    path: steps/02-context.md
    reason: compile the smallest repository-grounded engineering review context
    side_effect: none
    type: context
  - capabilities[2]: filesystem.read,filesystem.write
    commit_boundary: after-step
    condition:
      actions[0]:
      phases[1]: execute
      roles[3]: qa-engineer,software-architect,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: context
    gates[4]: dependencies,context-sufficiency,authorization,findings-before-fixes
    id: execute
    load: on-demand
    max_attempts: 1
    max_tokens: 3500
    on_failure: block
    operation: execute-procedure
    outputs[4]: post-fix-context,quality-gate-draft,remediation-evidence,verification-evidence
    path: steps/02-execute.md
    reason: "review adversarially, fix safe material findings, and rerun checks"
    side_effect: workspace-write
    type: action
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: validate
      roles[3]: qa-engineer,software-architect,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: execute
    gates[5]: output-evidence,schema,current-change,readiness-invariants,regression-risk
    id: validate
    load: before-completion
    max_attempts: 1
    max_tokens: 2600
    on_failure: block
    operation: validate-evidence
    outputs[3]: canonical-quality-report,readiness-decision,residual-risk
    path: steps/03-validate-and-handoff.md
    reason: "enforce report truthfulness, current evidence, and readiness policy"
    side_effect: none
    type: validation
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: handoff,complete
      roles[3]: qa-engineer,software-architect,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: validate
    gates[3]: terminal-evidence,next-owner,current-report
    id: handoff
    load: before-completion
    max_attempts: 1
    max_tokens: 1000
    on_failure: handoff
    operation: handoff-result
    outputs[2]: handoff,next-action
    path: steps/04-handoff.md
    reason: return a current report with an unambiguous owner and next action
    side_effect: none
    type: handoff
version: 4.1.0
