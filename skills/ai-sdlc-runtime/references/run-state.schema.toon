"$defs":
  hash:
    pattern: "^[a-f0-9]{64}$"
    type: string
  runtime_budgets:
    additionalProperties: false
    properties:
      max_failures:
        minimum: 1
        type: integer
      max_steps:
        minimum: 1
        type: integer
      max_tokens:
        minimum: 1
        type: integer
      used_failures:
        minimum: 0
        type: integer
      used_steps:
        minimum: 0
        type: integer
      used_tokens:
        minimum: 0
        type: integer
    required[6]: max_steps,max_failures,max_tokens,used_steps,used_failures,used_tokens
    type: object
"$id": ai-sdlc-run-state/v2
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  budgets:
    "$ref": #/$defs/runtime_budgets
  event_fingerprint:
    "$ref": #/$defs/hash
  fingerprint:
    "$ref": #/$defs/hash
  graph_fingerprint:
    "$ref": #/$defs/hash
  plan_fingerprint:
    "$ref": #/$defs/hash
  ready_tasks:
    items:
      type: string
    type: array
    uniqueItems: true
  run_id:
    minLength: 1
    type: string
  running_task:
    type: string
  schema:
    const: ai-sdlc-run-state/v2
  sequence:
    minimum: 0
    type: integer
  status:
    enum[4]: running,paused,completed,stopped
  stop_reason:
    type: string
  tasks:
    items:
      type: object
    minItems: 1
    type: array
required[13]: schema,run_id,plan_fingerprint,graph_fingerprint,sequence,event_fingerprint,status,stop_reason,running_task,ready_tasks,budgets,tasks,fingerprint
title: AI SDLC Replay-Derived Run State
type: object
