"$defs":
  hash:
    pattern: "^[a-f0-9]{64}$"
    type: string
"$id": ai-sdlc-workflow-plan/v2
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  approvals:
    items:
      type: object
    type: array
  capabilities:
    items:
      type: string
    type: array
    uniqueItems: true
  executable:
    type: boolean
  fingerprint:
    "$ref": #/$defs/hash
  node_decisions:
    items:
      additionalProperties: false
      properties:
        entrypoint:
          type: string
        id:
          type: string
        reason:
          type: string
        skill:
          type: string
        status:
          enum[4]: eligible,skipped,deferred,blocked
      required[5]: id,skill,entrypoint,status,reason
      type: object
    type: array
  run_plan:
    type: object
  schema:
    const: ai-sdlc-workflow-plan/v2
  side_effects:
    items:
      enum[4]: none,workspace-write,external-write,destructive
    type: array
    uniqueItems: true
  waves:
    items:
      additionalProperties: false
      properties:
        index:
          minimum: 1
          type: integer
        mode:
          enum[2]: sequential,parallel
        nodes:
          items:
            type: string
          minItems: 1
          type: array
      required[3]: index,mode,nodes
      type: object
    type: array
  workflow:
    additionalProperties: false
    properties:
      fingerprint:
        "$ref": #/$defs/hash
      id:
        type: string
      version:
        type: string
    required[3]: id,version,fingerprint
    type: object
required[10]: schema,workflow,node_decisions,waves,approvals,capabilities,side_effects,run_plan,executable,fingerprint
title: AI SDLC Compiled Workflow Plan
type: object
