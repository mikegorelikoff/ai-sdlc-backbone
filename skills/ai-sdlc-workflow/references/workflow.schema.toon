"$defs":
  condition:
    additionalProperties: false
    properties:
      field:
        pattern: "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
        type: string
      operator:
        enum[3]: eq,in,exists
      value: {}
    required[3]: field,operator,value
    type[2]: object,"null"
  node:
    additionalProperties: false
    properties:
      action:
        type: string
      approval_owner:
        type: string
      condition:
        "$ref": #/$defs/condition
      depends_on:
        items:
          type: string
        type: array
        uniqueItems: true
      entrypoint:
        enum[7]: prepare,clarify,route,execute,handoff,validate,complete
      id:
        pattern: "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        type: string
      role:
        enum[6]: "",business-analyst,product-manager,software-architect,software-engineer,qa-engineer
      skill:
        pattern: "^ai-sdlc-[a-z0-9]+(?:-[a-z0-9]+)*$"
        type: string
    required[8]: id,depends_on,skill,entrypoint,role,action,condition,approval_owner
    type: object
"$id": ai-sdlc-workflow/v2
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  id:
    pattern: "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    type: string
  nodes:
    items:
      "$ref": #/$defs/node
    minItems: 1
    type: array
  schema:
    const: ai-sdlc-workflow/v2
  version:
    pattern: "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    type: string
required[4]: schema,id,version,nodes
title: AI SDLC Skill-Graph Workflow
type: object
