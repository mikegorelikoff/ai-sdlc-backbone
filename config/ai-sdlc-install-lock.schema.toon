"$id": "https://raw.githubusercontent.com/mikegorelikoff/ai-sdlc-harness/main/config/ai-sdlc-install-lock.schema.toon"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  agent:
    const: codex
  installer:
    const: ai-sdlc-harness/4.0.1
  revision:
    pattern: "^[0-9a-f]{40}$"
    type: string
  schema:
    const: ai-sdlc-install-lock/v1
  selection:
    enum[2]: all-skills,explicit-skills
  skills:
    items:
      additionalProperties: false
      properties:
        name:
          pattern: "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          type: string
        path:
          pattern: "^\\.agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*$"
          type: string
        sha256:
          pattern: "^[0-9a-f]{64}$"
          type: string
      required[3]: name,path,sha256
      type: object
    minItems: 1
    type: array
  target:
    const: .agents/skills
required[7]: schema,revision,installer,agent,selection,skills,target
title: AI SDLC harness deterministic install lock
type: object
