"$id": "https://raw.githubusercontent.com/mikegorelikoff/ai-sdlc-harness/main/config/ai-sdlc-install-record.schema.toon"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  agent:
    minLength: 1
    type: string
  inventory:
    const: .ai-sdlc/harness-managed-skills.txt
  revision:
    pattern: "^[0-9a-f]{40}$"
    type: string
  schema:
    const: ai-sdlc-install-record/v1
  selection:
    enum[2]: all-skills,explicit-skills
  skills_cli:
    pattern: "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    type: string
required[6]: schema,revision,skills_cli,agent,selection,inventory
title: AI SDLC harness install record
type: object
