"$id": "https://raw.githubusercontent.com/mikegorelikoff/ai-sdlc-harness/main/config/ai-sdlc-install-record.schema.toon"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  agent:
    const: codex
  installer:
    const: ai-sdlc-harness/4.0.1
  inventory:
    const: .ai-sdlc/harness-managed-skills.txt
  lock:
    const: .ai-sdlc/harness-install-lock.toon
  revision:
    pattern: "^[0-9a-f]{40}$"
    type: string
  schema:
    const: ai-sdlc-install-record/v2
  selection:
    enum[2]: all-skills,explicit-skills
  target:
    const: .agents/skills
required[8]: schema,revision,installer,agent,selection,inventory,lock,target
title: AI SDLC harness install record
type: object
