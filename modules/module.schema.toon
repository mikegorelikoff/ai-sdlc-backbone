"$id": "https://ai-sdlc.local/schemas/ai-sdlc-module-v1.toon"
"$schema": ai-sdlc-toon-contract/v1
additionalProperties: false
properties:
  description:
    type: string
  harness_api:
    additionalProperties: false
    properties:
      max_exclusive:
        type: string
      min:
        type: string
    required[2]: min,max_exclusive
    type: object
  id:
    pattern: "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    type: string
  kind:
    enum[2]: core,optional
  requires:
    items:
      type: string
    type: array
    uniqueItems: true
  schema:
    const: ai-sdlc-module/v1
  skills:
    items:
      additionalProperties: false
      properties:
        name:
          type: string
        path:
          type: string
      required[2]: name,path
      type: object
    type: array
  version:
    pattern: "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    type: string
required[6]: schema,id,version,kind,harness_api,skills
title: AI SDLC module manifest
type: object
